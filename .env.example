# ==============================================================================
# Nalo SMS Platform - Environment Variables Example
# Copy this file to .env and replace placeholder values with your actual config.
# NEVER commit real .env files or API keys into git repository!
# ==============================================================================

# Nalo SMS API Authentication Key
# Read from an environment variable and never reaches the browser.
SMS_API_KEY=your_nalo_sms_api_key_here

# Allowed Sender IDs (comma-separated, max 11 chars each)
# Only Sender IDs registered on your Nalo account will deliver.
SENDER_IDS=NALO,MYBRAND,TEST_SMS

# Public Base URL for Delivery Callback Webhooks
# For local testing, use a tunnel like ngrok or Cloudflare Tunnel:
# e.g. https://xxxx.trycloudflare.com or https://xxxx.ngrok-free.app
# For production, set to your live deployment domain (e.g. https://my-sms-app.onrender.com)
CALLBACK_BASE_URL=https://your-public-domain-or-tunnel.com

# Server Port (optional, defaults to 3000)
PORT=3000
